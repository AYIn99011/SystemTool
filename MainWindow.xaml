<Window x:Class="SystemTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="系统工具箱" Height="800" Width="1280"
        MinHeight="640" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStyle="None"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="8"
                            GlassFrameThickness="-1"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <!-- 根布局：Mica 生效时透明，Win10 降级时由代码填纯色 -->
    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ======= 标题栏 ======= -->
        <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Image Source="/icon/1.ico" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="系统工具箱" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
                <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}"
                        Content="&#xE921;" Click="MinimizeButton_Click"/>
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}"
                        Content="&#xE922;" Click="MaximizeButton_Click"/>
                <Button x:Name="CloseButton" Style="{StaticResource CaptionCloseButton}"
                        Content="&#xE8BB;" Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- ======= 主体：导航 + 内容 ======= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧导航（Win11 设置式） -->
            <Border Grid.Column="0" Background="{StaticResource NavBackgroundBrush}"
                    BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,1,0"
                    CornerRadius="0,8,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="8,12,8,0">
                        <RadioButton x:Name="NavDeviceInfo" Style="{StaticResource NavItemStyle}"
                                     Tag="DeviceInfo" Content="设备信息" IsChecked="True"
                                     Checked="NavRadioButton_Checked">
                            <RadioButton.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/icon/信息.png" Width="18" Height="18"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="{Binding}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </RadioButton.ContentTemplate>
                        </RadioButton>
                        <RadioButton x:Name="NavCleaner" Style="{StaticResource NavItemStyle}"
                                     Tag="Cleaner" Content="清理垃圾"
                                     Checked="NavRadioButton_Checked">
                            <RadioButton.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/icon/垃圾桶.png" Width="18" Height="18"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="{Binding}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </RadioButton.ContentTemplate>
                        </RadioButton>
                        <RadioButton x:Name="NavOptimizer" Style="{StaticResource NavItemStyle}"
                                     Tag="Optimizer" Content="系统优化"
                                     Checked="NavRadioButton_Checked">
                            <RadioButton.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/icon/优化.png" Width="18" Height="18"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="{Binding}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </RadioButton.ContentTemplate>
                        </RadioButton>
                        <RadioButton x:Name="NavRepair" Style="{StaticResource NavItemStyle}"
                                     Tag="Repair" Content="修复系统"
                                     Checked="NavRadioButton_Checked">
                            <RadioButton.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/icon/修复.png" Width="18" Height="18"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="{Binding}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </RadioButton.ContentTemplate>
                        </RadioButton>
                        <RadioButton x:Name="NavTools" Style="{StaticResource NavItemStyle}"
                                     Tag="Tools" Content="其他工具"
                                     Checked="NavRadioButton_Checked">
                            <RadioButton.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/icon/其他.png" Width="18" Height="18"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="{Binding}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </RadioButton.ContentTemplate>
                        </RadioButton>
                        <RadioButton x:Name="NavLog" Style="{StaticResource NavItemStyle}"
                                     Tag="Log" Content="应用日志"
                                     Checked="NavRadioButton_Checked">
                            <RadioButton.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/icon/日志.png" Width="18" Height="18"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="{Binding}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </RadioButton.ContentTemplate>
                        </RadioButton>
                    </StackPanel>

                    <!-- 底部：管理员状态 + 加群 -->
                    <StackPanel Grid.Row="1" Margin="16,0,16,16">
                        <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0"
                                Padding="0,12,0,0" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" Cursor="Hand"
                                        HorizontalAlignment="Center"
                                        MouseLeftButtonDown="AdminStatus_Click">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}"
                                         VerticalAlignment="Center"/>
                                <TextBlock Text="管理员权限" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Button x:Name="JoinQQGroupButton" Style="{StaticResource FluentButton}"
                                Content="加入用户交流群" Click="JoinQQGroupButton_Click"/>
                        <!-- 字体大小调节：整体缩放界面，窗口等比缩放 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Button x:Name="FontDecreaseButton" Style="{StaticResource FluentButton}"
                                    Content="A-" Width="38" MinHeight="28" Padding="0"
                                    Click="FontDecrease_Click" ToolTip="减小字体"/>
                            <TextBlock x:Name="FontScaleText" Text="110%" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="8,0" MinWidth="40"
                                       TextAlignment="Center"/>
                            <Button x:Name="FontIncreaseButton" Style="{StaticResource FluentButton}"
                                    Content="A+" Width="38" MinHeight="28" Padding="0"
                                    Click="FontIncrease_Click" ToolTip="增大字体"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 右侧内容区 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="PageTitle" Grid.Row="0" Text="设备信息"
                           FontSize="22" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="32,20,32,12"/>

                <Frame x:Name="MainFrame" Grid.Row="1"
                       NavigationUIVisibility="Hidden"
                       Background="Transparent" Margin="0,0,0,0"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
