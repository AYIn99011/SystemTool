<Window x:Class="SystemTool.Windows.PawnIoInstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="安装测温驱动" Height="380" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        Background="{StaticResource SectionFillBrush}">
    <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8"
            Background="{StaticResource SectionFillBrush}" Margin="12" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="检测到 CPU 温度无法读取"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>

            <StackPanel Grid.Row="1">
                <TextBlock TextWrapping="Wrap" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}" LineHeight="22">
                    <Run Text="CPU 温度需要 PawnIO 内核驱动才能读取（ LibreHardwareMonitor 0.9.5+ 已改用它替代旧驱动 ）。"/>
                    <LineBreak/>
                    <Run Text="该驱动由 namazso.eu 数字签名，兼容 Windows 11 内存完整性（HVCI），安装后无需关闭任何安全功能。"/>
                </TextBlock>
                <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0"
                           Foreground="{StaticResource TextTertiaryBrush}" LineHeight="20">
                    <Run Text="点击“安装驱动”后将自动完成：从官方 GitHub 下载安装包（约 3.4MB）→ 校验哈希与数字签名 → 静默安装。"/>
                    <LineBreak/>
                    <Run Text="安装可能需要重启电脑才能生效。全程不会安装其他软件。"/>
                </TextBlock>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0"
                           Foreground="{StaticResource InfoBrush}" Visibility="Collapsed"/>
                <ProgressBar x:Name="InstallProgress" Height="4" Margin="0,10,0,0"
                             IsIndeterminate="True" Visibility="Collapsed"
                             Foreground="{StaticResource AccentBrush}" Background="Transparent" BorderThickness="0"/>
            </StackPanel>

            <CheckBox x:Name="NeverRemindCheckBox" Grid.Row="2" Content="不再提醒"
                      FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="暂不安装" Width="96" Height="32" Margin="0,0,8,0"
                        Click="CancelButton_Click"/>
                <Button x:Name="InstallButton" Content="安装驱动" Width="96" Height="32"
                        Background="{StaticResource AccentBrush}" Foreground="{StaticResource OnAccentBrush}"
                        BorderThickness="0" Click="InstallButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
