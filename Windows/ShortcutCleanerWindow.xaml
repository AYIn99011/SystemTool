<Window x:Class="SystemTool.Windows.ShortcutCleanerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="此电脑快捷方式清理" Height="550" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{StaticResource SectionFillBrush}">

    <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8"
            Background="{StaticResource SectionFillBrush}" Margin="12" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="以下是在「此电脑」中发现的快捷方式" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="勾选要删除的快捷方式（盘符和系统文件夹不会显示）" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <Border Grid.Row="1" Background="{StaticResource ControlFillBrush}" CornerRadius="8" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <ItemsControl x:Name="ShortcutsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              VerticalAlignment="Center" Margin="4,0,10,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                                        <TextBlock Text="{Binding TargetPath}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Image Grid.Column="2" Source="{Binding Icon}" Width="24" Height="24"
                                           VerticalAlignment="Center" Margin="8,0,4,0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="全选" Width="84" Height="32" Margin="0,0,8,0" Cursor="Hand"
                            Style="{StaticResource FluentButton}" Click="SelectAll_Click"/>
                    <Button Content="取消全选" Width="84" Height="32" Margin="0,0,8,0" Cursor="Hand"
                            Style="{StaticResource FluentButton}" Click="DeselectAll_Click"/>
                    <Button Content="删除选中" Width="96" Height="32" Cursor="Hand"
                            Style="{StaticResource AccentButton}" Click="DeleteSelected_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
