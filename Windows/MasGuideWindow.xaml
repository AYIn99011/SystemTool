<Window x:Class="SystemTool.Windows.MasGuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="激活 Windows" Height="460" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        Background="{StaticResource SectionFillBrush}">
    <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8"
            Background="{StaticResource SectionFillBrush}" Margin="12" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="激活操作指引"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}" LineHeight="22">
                        <Run Text="即将启动 Microsoft Activation Scripts（MAS）激活工具。它的菜单是英文的，各选项含义如下："/>
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" FontSize="13" Margin="0,10,0,0"
                               Foreground="{StaticResource TextPrimaryBrush}" LineHeight="24">
                        <Run Text="• HWID —— Windows 10/11 数字许可证（永久，推荐）"/>
                        <LineBreak/>
                        <Run Text="• Ohook —— Office 激活（永久）"/>
                        <LineBreak/>
                        <Run Text="• Online KMS —— Windows / Office，180 天有效（自动续期）"/>
                        <LineBreak/>
                        <Run Text="• Check Activation Status —— 查看当前激活状态"/>
                        <LineBreak/>
                        <Run Text="• Troubleshoot —— 激活失败时排查"/>
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,12,0,0"
                               Foreground="{StaticResource TextTertiaryBrush}" LineHeight="20">
                        <Run Text="说明：菜单中绿色高亮的为推荐选项；HWID 需要联网（向微软服务器申请数字许可证）；激活过程可能被杀毒软件拦截，属正常现象，放行即可。"/>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="CancelButton" Content="取消" Width="96" Height="32" Margin="0,0,8,0"
                        Click="CancelButton_Click"/>
                <Button x:Name="StartButton" Content="开始激活" Width="96" Height="32"
                        Background="{StaticResource AccentBrush}" Foreground="{StaticResource OnAccentBrush}"
                        BorderThickness="0" Click="StartButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
