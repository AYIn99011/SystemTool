<Page x:Class="SystemTool.Pages.RepairPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="修复系统"
      Background="Transparent"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True">

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Hidden">
            <Grid Margin="30,15,30,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Background="#12121f" CornerRadius="16" Padding="25" Margin="0,0,0,20">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" Opacity="0.3" BlurRadius="15" ShadowDepth="3" Direction="270"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                                <Border Width="48" Height="48" CornerRadius="12" Background="#1e1e35">
                                    <Viewbox Width="26" Height="26">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="#14b8a6" Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M11,9H13V17H11V9M12,7.5A1,1 0 0,1 13,8.5A1,1 0 0,1 12,9.5A1,1 0 0,1 11,8.5A1,1 0 0,1 12,7.5Z"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <TextBlock Text="系统文件修复" FontSize="18" FontWeight="Normal" Foreground="#ffffff" 
                                           VerticalAlignment="Center" Margin="15,0,0,0"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="使用系统自带工具扫描和修复系统文件" 
                                       Foreground="#7a7a9a" FontSize="13" Margin="0,0,0,20"/>

                            <Button Grid.Row="2" Content="运行SFC扫描" HorizontalAlignment="Left" Cursor="Hand" Click="RunSfcScan_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ButtonBorder" Background="#14b8a6" CornerRadius="10" Padding="25,12">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#14b8a6" Opacity="0.4" BlurRadius="12" ShadowDepth="0"/>
                                            </Border.Effect>
                                            <TextBlock Text="{TemplateBinding Content}" FontSize="13" 
                                                       Foreground="#ffffff" FontWeight="Normal"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ButtonBorder" Property="Background" Value="#2dd4bf"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="ButtonBorder" Property="Background" Value="#0d9488"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Background="#12121f" CornerRadius="16" Padding="25" Margin="0,0,0,20">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" Opacity="0.3" BlurRadius="15" ShadowDepth="3" Direction="270"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                                <Border Width="48" Height="48" CornerRadius="12" Background="#1e1e35">
                                    <Viewbox Width="26" Height="26">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="#e94560" Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M11,9H13V17H11V9M12,7.5A1,1 0 0,1 13,8.5A1,1 0 0,1 12,9.5A1,1 0 0,1 11,8.5A1,1 0 0,1 12,7.5Z"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <TextBlock Text="DISM系统映像修复" FontSize="18" FontWeight="Normal" Foreground="#ffffff" 
                                           VerticalAlignment="Center" Margin="15,0,0,0"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="修复Windows系统映像，解决更深层次的系统问题" 
                                       Foreground="#7a7a9a" FontSize="13" Margin="0,0,0,20"/>

                            <Button Grid.Row="2" Content="运行DISM修复" HorizontalAlignment="Left" Cursor="Hand" Click="RunDismRepair_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ButtonBorder" Background="#e94560" CornerRadius="10" Padding="25,12">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#e94560" Opacity="0.4" BlurRadius="12" ShadowDepth="0"/>
                                            </Border.Effect>
                                            <TextBlock Text="{TemplateBinding Content}" FontSize="13" 
                                                       Foreground="#ffffff" FontWeight="Normal"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ButtonBorder" Property="Background" Value="#ff6b8a"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="ButtonBorder" Property="Background" Value="#c73e54"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Background="#12121f" CornerRadius="16" Padding="25" Margin="0,0,0,20">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" Opacity="0.3" BlurRadius="15" ShadowDepth="3" Direction="270"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                                <Border Width="48" Height="48" CornerRadius="12" Background="#1e1e35">
                                    <Viewbox Width="26" Height="26">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="#8b5cf6" Data="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <TextBlock Text="DLL修复工具" FontSize="18" FontWeight="Normal" Foreground="#ffffff" 
                                           VerticalAlignment="Center" Margin="15,0,0,0"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="下载DLL修复工具，修复缺失的DLL文件" 
                                       Foreground="#7a7a9a" FontSize="13" Margin="0,0,0,20"/>

                            <Button Grid.Row="2" Content="下载DLL工具" HorizontalAlignment="Left" Cursor="Hand" Click="DownloadDllTool_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ButtonBorder" Background="#8b5cf6" CornerRadius="10" Padding="25,12">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#8b5cf6" Opacity="0.4" BlurRadius="12" ShadowDepth="0"/>
                                            </Border.Effect>
                                            <TextBlock Text="{TemplateBinding Content}" FontSize="13" 
                                                       Foreground="#ffffff" FontWeight="Normal"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ButtonBorder" Property="Background" Value="#a78bfa"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="ButtonBorder" Property="Background" Value="#7c3aed"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
