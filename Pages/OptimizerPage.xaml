<Page x:Class="SystemTool.Pages.OptimizerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="优化系统"
      Background="Transparent"
      TextOptions.TextFormattingMode="Ideal"
      TextOptions.TextRenderingMode="ClearType"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True">

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Hidden">
            <StackPanel Margin="30,15,30,20">

                <!-- 页头 -->
                <Border Background="{StaticResource SectionFillBrush}" CornerRadius="12"
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                        Padding="22,18" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="系统优化" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="共 16 项优化 · 调整系统性能与外观" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ============ 性能优化 ============ -->
                <TextBlock Text="性能优化" Style="{StaticResource SectionTitle}" Margin="4,4,0,10"/>
                <UniformGrid Columns="2" Margin="-6,0,-6,8">

                    <Border Background="{StaticResource SectionFillBrush}" CornerRadius="12"
                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                            Padding="18" Margin="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="内存优化" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Grid.Row="1" Text="释放内存空间，提升系统响应速度" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,14" TextWrapping="Wrap" MinHeight="34"/>
                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <Button Content="优化内存" Style="{StaticResource AccentButton}" Click="OptimizeMemory_Click" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Background="{StaticResource SectionFillBrush}" CornerRadius="12"
                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                            Padding="18" Margin="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="大系统缓存" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Grid.Row="1" Text="启用大系统缓存以提高系统性能（需 1GB 以上内存）" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,14" TextWrapping="Wrap" MinHeight="34"/>
                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <Button Content="启用" Style="{StaticResource AccentButton}" Click="EnableLargeSystemCache_Click" Cursor="Hand"/>
                                <Button Content="禁用" Style="{StaticResource FluentButton}" Click="DisableLargeSystemCache_Click" Margin="8,0,0,0" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Background="{StaticResource SectionFillBrush}" CornerRadius="12"
                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                            Padding="18" Margin="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="文件系统缓存" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Grid.Row="1" Text="将文件系统缓存增加至 256MB（需 2GB 以上内存）" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,14" TextWrapping="Wrap" MinHeight="34"/>
                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <Button Content="启用" Style="{StaticResource AccentButton}" Click="EnableIoPageLock_Click" Cursor="Hand"/>
                                <Button Content="禁用" Style="{StaticResource FluentButton}" Click="DisableIoPageLock_Click" Margin="8,0,0,0" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Background="{StaticResource SectionFillBrush}" CornerRadius="12"
                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                            Padding="18" Margin="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="禁止内核分页" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Grid.Row="1" Text="禁止系统内核与驱动程序分页到硬盘" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,14" TextWrapping="Wrap" MinHeight="34"/>
                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <Button Content="启用" Style="{StaticResource AccentButton}" Click="EnableDisablePaging_Click" Cursor="Hand"/>
                                <Button Content="禁用" Style="{StaticResource FluentButton}" Click="DisableDisablePaging_Click" Margin="8,0,0,0" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Background="{StaticResource SectionFillBrush}" CornerRadius="12"
                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                            Padding="18" Margin="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="卓越性能电源计划" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Grid.Row="1" Text="启用 Windows 隐藏的卓越性能电源计划，提升系统响应速度" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,14" TextWrapping="Wrap" MinHeight="34"/>
                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <Button Content="启用卓越性能" Style="{StaticResource AccentButton}" Click="EnableUltimatePerformance_Click" Cursor="Hand"/>
                                <Button Content="恢复平衡模式" Style="{StaticResource FluentButton}" Click="RestoreBalancedPowerPlan_Click" Margin="8,0,0,0" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Background="{StaticResource SectionFillBrush}" CornerRadius="12"
                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                            Padding="18" Margin="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="VBS 与内核隔离" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Grid.Row="1" Text="关闭 VBS 和内核完整性可提升游戏性能（需重启生效）" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,14" TextWrapping="Wrap" MinHeight="34"/>
                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <Button Content="关闭 VBS" Style="{StaticResource AccentButton}" Click="DisableVBS_Click" Cursor="Hand"/>
                                <Button Content="开启 VBS" Style="{StaticResource FluentButton}" Click="EnableVBS_Click" Margin="8,0,0,0" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Background="{StaticResource SectionFillBrush}" CornerRadius="12"
                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                            Padding="18" Margin="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="快速启动" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Grid.Row="1" Text="关闭快速启动可避免某些兼容性问题" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,14" TextWrapping="Wrap" MinHeight="34"/>
                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <Button Content="关闭快速启动" Style="{StaticResource AccentButton}" Click="DisableFastStartup_Click" Cursor="Hand"/>
                                <Button Content="开启快速启动" Style="{StaticResource FluentButton}" Click="EnableFastStartup_Click" Margin="8,0,0,0" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                </UniformGrid>

                <!-- ============ 外观与体验 ============ -->
                <TextBlock Text="外观与体验" Style="{StaticResource SectionTitle}" Margin="4,4,0,10"/>
                <UniformGrid Columns="2" Margin="-6,0,-6,8">

                    <Border Background="{StaticResource SectionFillBrush}" CornerRadius="12"
                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                            Padding="18" Margin="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Win11 经典右键菜单" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Grid.Row="1" Text="将 Win11 右键菜单恢复为 Win10 经典样式" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,14" TextWrapping="Wrap" MinHeight="34"/>
                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <Button Content="恢复经典" Style="{StaticResource AccentButton}" Click="EnableClassicContextMenu_Click" Cursor="Hand"/>
                                <Button Content="恢复默认" Style="{StaticResource FluentButton}" Click="DisableClassicContextMenu_Click" Margin="8,0,0,0" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Background="{StaticResource SectionFillBrush}" CornerRadius="12"
                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                            Padding="18" Margin="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Win11 经典资源管理器" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Grid.Row="1" Text="将 Win11 资源管理器恢复为 Win10 经典样式" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,14" TextWrapping="Wrap" MinHeight="34"/>
                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <Button Content="恢复经典" Style="{StaticResource AccentButton}" Click="EnableClassicExplorer_Click" Cursor="Hand"/>
                                <Button Content="恢复默认" Style="{StaticResource FluentButton}" Click="DisableClassicExplorer_Click" Margin="8,0,0,0" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Background="{StaticResource SectionFillBrush}" CornerRadius="12"
                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                            Padding="18" Margin="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="快捷方式小箭头" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Grid.Row="1" Text="隐藏或恢复快捷方式左下角的小箭头图标" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,14" TextWrapping="Wrap" MinHeight="34"/>
                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <Button Content="隐藏箭头" Style="{StaticResource AccentButton}" Click="HideShortcutArrow_Click" Cursor="Hand"/>
                                <Button Content="恢复箭头" Style="{StaticResource FluentButton}" Click="ShowShortcutArrow_Click" Margin="8,0,0,0" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Background="{StaticResource SectionFillBrush}" CornerRadius="12"
                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                            Padding="18" Margin="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="可执行文件小盾牌" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Grid.Row="1" Text="隐藏或恢复可执行文件左下角的 UAC 盾牌图标" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,14" TextWrapping="Wrap" MinHeight="34"/>
                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <Button Content="隐藏盾牌" Style="{StaticResource AccentButton}" Click="HideUacShield_Click" Cursor="Hand"/>
                                <Button Content="恢复盾牌" Style="{StaticResource FluentButton}" Click="ShowUacShield_Click" Margin="8,0,0,0" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Background="{StaticResource SectionFillBrush}" CornerRadius="12"
                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                            Padding="18" Margin="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="显示隐藏文件" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Grid.Row="1" Text="显示或隐藏系统中的隐藏文件和文件夹" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,14" TextWrapping="Wrap" MinHeight="34"/>
                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <Button Content="显示隐藏" Style="{StaticResource AccentButton}" Click="ShowHiddenFiles_Click" Cursor="Hand"/>
                                <Button Content="隐藏文件" Style="{StaticResource FluentButton}" Click="HideHiddenFiles_Click" Margin="8,0,0,0" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Background="{StaticResource SectionFillBrush}" CornerRadius="12"
                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                            Padding="18" Margin="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="任务栏时钟秒数" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Grid.Row="1" Text="在任务栏时钟中显示或隐藏秒数" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,14" TextWrapping="Wrap" MinHeight="34"/>
                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <Button Content="显示秒数" Style="{StaticResource AccentButton}" Click="ShowClockSeconds_Click" Cursor="Hand"/>
                                <Button Content="隐藏秒数" Style="{StaticResource FluentButton}" Click="HideClockSeconds_Click" Margin="8,0,0,0" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                </UniformGrid>

                <!-- ============ 系统功能 ============ -->
                <TextBlock Text="系统功能" Style="{StaticResource SectionTitle}" Margin="4,4,0,10"/>
                <UniformGrid Columns="2" Margin="-6,0,-6,8">

                    <Border Background="{StaticResource SectionFillBrush}" CornerRadius="12"
                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                            Padding="18" Margin="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="激活 Windows" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Grid.Row="1" Text="使用 Microsoft Activation Scripts 激活 Windows 系统" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,14" TextWrapping="Wrap" MinHeight="34"/>
                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <Button Content="激活 Windows" Style="{StaticResource AccentButton}" Click="ActivateWindows_Click" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Background="{StaticResource SectionFillBrush}" CornerRadius="12"
                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                            Padding="18" Margin="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="暂停 Windows 更新" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Grid.Row="1" Text="暂停系统自动更新到 2052 年" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,14" TextWrapping="Wrap" MinHeight="34"/>
                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <Button Content="暂停更新" Style="{StaticResource AccentButton}" Click="PauseWindowsUpdate_Click" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Background="{StaticResource SectionFillBrush}" CornerRadius="12"
                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                            Padding="18" Margin="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="禁用系统日志" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Grid.Row="1" Text="禁用组件堆栈、更新解压、登录报告、网络事件等日志" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,14" TextWrapping="Wrap" MinHeight="34"/>
                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <Button Content="禁用日志" Style="{StaticResource AccentButton}" Click="DisableSystemLogs_Click" Cursor="Hand"/>
                                <Button Content="恢复日志" Style="{StaticResource FluentButton}" Click="EnableSystemLogs_Click" Margin="8,0,0,0" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                </UniformGrid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
