<Page x:Class="SystemTool.Pages.OptimizerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="优化系统"
      Background="Transparent"
      TextOptions.TextFormattingMode="Ideal"
      TextOptions.TextRenderingMode="ClearType"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True">

    <Page.Resources>
        <DropShadowEffect x:Key="CardShadow" Color="#000000" Opacity="0.3" BlurRadius="15" ShadowDepth="3" Direction="270"/>
    </Page.Resources>

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Hidden">
            <Grid Margin="30,15,30,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Background="#12121f" CornerRadius="16" Padding="25" Margin="0,0,0,20">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" Opacity="0.3" BlurRadius="15" ShadowDepth="3" Direction="270"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                                <Border Width="48" Height="48" CornerRadius="12" Background="#1e1e35">
                                    <Viewbox Width="26" Height="26">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="#22c55e" Data="M10,17L5,12L6.41,10.58L10,14.17L17.59,6.58L19,8M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <TextBlock Text="激活Windows" FontSize="18" FontWeight="Normal" Foreground="#ffffff" 
                                           VerticalAlignment="Center" Margin="15,0,0,0"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="使用Microsoft Activation Scripts激活Windows系统" 
                                       Foreground="#7a7a9a" FontSize="13" Margin="0,0,0,20"/>

                            <Button Grid.Row="2" Content="激活Windows" HorizontalAlignment="Left" Cursor="Hand" Click="ActivateWindows_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ButtonBorder" Background="#22c55e" CornerRadius="10" Padding="25,12">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#22c55e" Opacity="0.4" BlurRadius="12" ShadowDepth="0"/>
                                            </Border.Effect>
                                            <TextBlock Text="{TemplateBinding Content}" FontSize="13" 
                                                       Foreground="#ffffff" FontWeight="Normal"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ButtonBorder" Property="Background" Value="#4ade80"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="ButtonBorder" Property="Background" Value="#16a34a"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Background="#12121f" CornerRadius="16" Padding="25" Margin="0,0,0,20">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" Opacity="0.3" BlurRadius="15" ShadowDepth="3" Direction="270"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                                <Border Width="48" Height="48" CornerRadius="12" Background="#1e1e35">
                                    <Viewbox Width="26" Height="26">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="#34d399" Data="M12 2C6.5 2 2 6.5 2 12S6.5 22 12 22 22 17.5 22 12 17.5 2 12 2M12 20C7.59 20 4 16.41 4 12S7.59 4 12 4 20 7.59 20 12 16.41 20 12 20M12.5 7H11V13L16.2 16.2L17 14.9L12.5 12.2V7Z"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <TextBlock Text="暂停Windows更新" FontSize="18" FontWeight="Normal" Foreground="#ffffff" 
                                           VerticalAlignment="Center" Margin="15,0,0,0"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="暂停系统自动更新到2052年" 
                                       Foreground="#7a7a9a" FontSize="13" Margin="0,0,0,20"/>

                            <Button Grid.Row="2" Content="暂停更新" HorizontalAlignment="Left" Cursor="Hand" Click="PauseWindowsUpdate_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ButtonBorder" Background="#e94560" CornerRadius="10" Padding="25,12">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#e94560" Opacity="0.4" BlurRadius="12" ShadowDepth="0"/>
                                            </Border.Effect>
                                            <TextBlock Text="{TemplateBinding Content}" FontSize="13" 
                                                       Foreground="#ffffff" FontWeight="Normal"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ButtonBorder" Property="Background" Value="#ff6b8a"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="ButtonBorder" Property="Background" Value="#c73e54"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Background="#12121f" CornerRadius="16" Padding="25" Margin="0,0,0,20">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" Opacity="0.3" BlurRadius="15" ShadowDepth="3" Direction="270"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                                <Border Width="48" Height="48" CornerRadius="12" Background="#1e1e35">
                                    <Viewbox Width="26" Height="26">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="#e94560" Data="M13,2.05V5.08C16.39,5.56 19,8.5 19,12C19,15.5 16.39,18.44 13,18.92V21.95C18.05,21.45 22,17.19 22,12C22,6.81 18.05,2.55 13,2.05M12,19A7,7 0 0,1 5,12A7,7 0 0,1 12,5C12.34,5 12.67,5.03 13,5.08V2.05C12.67,2.02 12.34,2 12,2C6.48,2 2,6.48 2,12C2,17.52 6.48,22 12,22C12.34,22 12.67,21.98 13,21.95V18.92C12.67,18.97 12.34,19 12,19Z"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <TextBlock Text="内存优化" FontSize="18" FontWeight="Normal" Foreground="#ffffff" 
                                           VerticalAlignment="Center" Margin="15,0,0,0"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="释放内存空间，提升系统响应速度" 
                                       Foreground="#7a7a9a" FontSize="13" Margin="0,0,0,20"/>

                            <Button Grid.Row="2" Content="优化内存" HorizontalAlignment="Left" Cursor="Hand" Click="OptimizeMemory_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ButtonBorder" Background="#e94560" CornerRadius="10" Padding="25,12">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#e94560" Opacity="0.4" BlurRadius="12" ShadowDepth="0"/>
                                            </Border.Effect>
                                            <TextBlock Text="{TemplateBinding Content}" FontSize="13" 
                                                       Foreground="#ffffff" FontWeight="Normal"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ButtonBorder" Property="Background" Value="#ff6b8a"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="ButtonBorder" Property="Background" Value="#c73e54"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Background="#12121f" CornerRadius="16" Padding="25" Margin="0,0,0,20">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" Opacity="0.3" BlurRadius="15" ShadowDepth="3" Direction="270"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                                <Border Width="48" Height="48" CornerRadius="12" Background="#1e1e35">
                                    <Viewbox Width="26" Height="26">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="#fb923c" Data="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M12,5A3,3 0 0,1 15,8A3,3 0 0,1 12,11A3,3 0 0,1 9,8A3,3 0 0,1 12,5M17.13,17C15.92,18.85 14.11,20.24 12,20.92C9.89,20.24 8.08,18.85 6.87,17C6.53,16.5 6.24,16 6,15.47C6,13.82 8.71,12.47 12,12.47C15.29,12.47 18,13.79 18,15.47C17.76,16 17.47,16.5 17.13,17Z"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <TextBlock Text="可执行文件小盾牌" FontSize="18" FontWeight="Normal" Foreground="#ffffff" 
                                           VerticalAlignment="Center" Margin="15,0,0,0"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="隐藏或恢复可执行文件左下角的UAC盾牌图标" 
                                       Foreground="#7a7a9a" FontSize="13" Margin="0,0,0,15"/>

                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <Button Content="隐藏盾牌" HorizontalAlignment="Left" Cursor="Hand" Click="HideUacShield_Click" Margin="0,0,10,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ButtonBorder" Background="#e94560" CornerRadius="10" Padding="20,12">
                                                <TextBlock Text="{TemplateBinding Content}" FontSize="13" 
                                                           Foreground="#ffffff" FontWeight="Normal"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#ff6b8a"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#c73e54"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Content="恢复盾牌" HorizontalAlignment="Left" Cursor="Hand" Click="ShowUacShield_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ButtonBorder" Background="#3b3b5c" CornerRadius="10" Padding="20,12">
                                                <TextBlock Text="{TemplateBinding Content}" FontSize="13" 
                                                           Foreground="#ffffff" FontWeight="Normal"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#4b4b6c"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#2b2b4c"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Background="#12121f" CornerRadius="16" Padding="25" Margin="0,0,0,20">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" Opacity="0.3" BlurRadius="15" ShadowDepth="3" Direction="270"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                                <Border Width="48" Height="48" CornerRadius="12" Background="#1e1e35">
                                    <Viewbox Width="26" Height="26">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="#fbbf24" Data="M13,2.05V5.08C16.39,5.56 19,8.5 19,12C19,15.5 16.39,18.44 13,18.92V21.95C18.05,21.45 22,17.19 22,12C22,6.81 18.05,2.55 13,2.05M12,19A7,7 0 0,1 5,12A7,7 0 0,1 12,5C12.34,5 12.67,5.03 13,5.08V2.05C12.67,2.02 12.34,2 12,2C6.48,2 2,6.48 2,12C2,17.52 6.48,22 12,22C12.34,22 12.67,21.98 13,21.95V18.92C12.67,18.97 12.34,19 12,19Z"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <TextBlock Text="大系统缓存" FontSize="18" FontWeight="Normal" Foreground="#ffffff" 
                                           VerticalAlignment="Center" Margin="15,0,0,0"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="启用大系统缓存以提高系统性能（需1GB以上内存）" 
                                       Foreground="#7a7a9a" FontSize="13" Margin="0,0,0,15"/>

                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <Button Content="启用" HorizontalAlignment="Left" Cursor="Hand" Click="EnableLargeSystemCache_Click" Margin="0,0,10,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ButtonBorder" Background="#e94560" CornerRadius="10" Padding="20,12">
                                                <TextBlock Text="{TemplateBinding Content}" FontSize="13" 
                                                           Foreground="#ffffff" FontWeight="Normal"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#ff6b8a"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#c73e54"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Content="禁用" HorizontalAlignment="Left" Cursor="Hand" Click="DisableLargeSystemCache_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ButtonBorder" Background="#3b3b5c" CornerRadius="10" Padding="20,12">
                                                <TextBlock Text="{TemplateBinding Content}" FontSize="13" 
                                                           Foreground="#ffffff" FontWeight="Normal"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#4b4b6c"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#2b2b4c"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Background="#12121f" CornerRadius="16" Padding="25" Margin="0,0,0,20">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" Opacity="0.3" BlurRadius="15" ShadowDepth="3" Direction="270"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                                <Border Width="48" Height="48" CornerRadius="12" Background="#1e1e35">
                                    <Viewbox Width="26" Height="26">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="#f59e0b" Data="M11 2L13 2L13 7L21 7L21 9L13 9L13 11L19 11L19 13L13 13L13 15L17 15L17 17L13 17L13 20L11 20L11 17L7 17L7 15L11 15L11 13L5 13L5 11L11 11L11 9L3 9L3 7L11 7L11 2Z"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <TextBlock Text="卓越性能电源计划" FontSize="18" FontWeight="Normal" Foreground="#ffffff" 
                                           VerticalAlignment="Center" Margin="15,0,0,0"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="启用Windows隐藏的卓越性能电源计划，提升系统响应速度" 
                                       Foreground="#7a7a9a" FontSize="13" Margin="0,0,0,15"/>

                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <Button Content="启用卓越性能" HorizontalAlignment="Left" Cursor="Hand" Click="EnableUltimatePerformance_Click" Margin="0,0,10,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ButtonBorder" Background="#e94560" CornerRadius="10" Padding="20,12">
                                                <TextBlock Text="{TemplateBinding Content}" FontSize="13" 
                                                           Foreground="#ffffff" FontWeight="Normal"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#ff6b8a"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#c73e54"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Content="恢复平衡模式" HorizontalAlignment="Left" Cursor="Hand" Click="RestoreBalancedPowerPlan_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ButtonBorder" Background="#3b3b5c" CornerRadius="10" Padding="20,12">
                                                <TextBlock Text="{TemplateBinding Content}" FontSize="13" 
                                                           Foreground="#ffffff" FontWeight="Normal"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#4b4b6c"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#2b2b4c"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Background="#12121f" CornerRadius="16" Padding="25" Margin="0,0,0,20">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" Opacity="0.3" BlurRadius="15" ShadowDepth="3" Direction="270"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                                <Border Width="48" Height="48" CornerRadius="12" Background="#1e1e35">
                                    <Viewbox Width="26" Height="26">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="#8b5cf6" Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4M11,17H13V15H11V17M11,13H13V7H11V13Z"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <TextBlock Text="Win11经典右键菜单" FontSize="18" FontWeight="Normal" Foreground="#ffffff" 
                                           VerticalAlignment="Center" Margin="15,0,0,0"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="将Win11右键菜单恢复为Win10经典样式" 
                                       Foreground="#7a7a9a" FontSize="13" Margin="0,0,0,15"/>

                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <Button Content="恢复经典" HorizontalAlignment="Left" Cursor="Hand" Click="EnableClassicContextMenu_Click" Margin="0,0,10,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ButtonBorder" Background="#e94560" CornerRadius="10" Padding="20,12">
                                                <TextBlock Text="{TemplateBinding Content}" FontSize="13" 
                                                           Foreground="#ffffff" FontWeight="Normal"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#ff6b8a"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#c73e54"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Content="恢复默认" HorizontalAlignment="Left" Cursor="Hand" Click="DisableClassicContextMenu_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ButtonBorder" Background="#3b3b5c" CornerRadius="10" Padding="20,12">
                                                <TextBlock Text="{TemplateBinding Content}" FontSize="13" 
                                                           Foreground="#ffffff" FontWeight="Normal"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#4b4b6c"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#2b2b4c"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Background="#12121f" CornerRadius="16" Padding="25" Margin="0,0,0,20">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" Opacity="0.3" BlurRadius="15" ShadowDepth="3" Direction="270"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                                <Border Width="48" Height="48" CornerRadius="12" Background="#1e1e35">
                                    <Viewbox Width="26" Height="26">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="#06b6d4" Data="M3,3H21C22.1,3 23,3.9 23,5V19C23,20.1 22.1,21 21,21H3C1.9,21 1,20.1 1,19V5C1,3.9 1.9,3 3,3M3,5V19H21V5H3M5,7H19V9H5V7M5,11H19V13H5V11M5,15H14V17H5V15Z"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <TextBlock Text="Win11经典资源管理器" FontSize="18" FontWeight="Normal" Foreground="#ffffff" 
                                           VerticalAlignment="Center" Margin="15,0,0,0"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="将Win11资源管理器恢复为Win10经典样式" 
                                       Foreground="#7a7a9a" FontSize="13" Margin="0,0,0,15"/>

                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <Button Content="恢复经典" HorizontalAlignment="Left" Cursor="Hand" Click="EnableClassicExplorer_Click" Margin="0,0,10,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ButtonBorder" Background="#e94560" CornerRadius="10" Padding="20,12">
                                                <TextBlock Text="{TemplateBinding Content}" FontSize="13" 
                                                           Foreground="#ffffff" FontWeight="Normal"/>
