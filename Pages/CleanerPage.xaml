<Page x:Class="SystemTool.Pages.CleanerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="清理垃圾"
      Background="Transparent"
      TextOptions.TextFormattingMode="Ideal"
      TextOptions.TextRenderingMode="ClearType"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True">

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Hidden" Background="Transparent">
            <StackPanel Margin="32,8,32,24">

                <!-- 顶部汇总条 -->
                <Border Background="{StaticResource SectionFillBrush}" CornerRadius="16" Padding="28,24" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="120" Height="120">
                            <Ellipse Width="108" Height="108" Fill="Transparent"
                                     Stroke="{StaticResource DividerBrush}" StrokeThickness="10"/>
                            <Path x:Name="RingArc" Fill="Transparent"
                                  Stroke="{StaticResource AccentBrush}" StrokeThickness="10"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                            <Viewbox Width="42" Height="42">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{StaticResource TextSecondaryBrush}" Data="M9,3V4H4V6H5V19A2,2 0 0,0 7,21H17A2,2 0 0,0 19,19V6H20V4H15V3H9M7,6H17V19H7V6M9,8V17H11V8H9M13,8V17H15V8H13"/>
                                </Canvas>
                            </Viewbox>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="26,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="预估可清理：" FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="EstimateText" Text="点击右方按钮开始扫描" FontSize="34" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,8"/>
                            <TextBlock x:Name="LastCleanText" Text="上次清理：--" FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <Button x:Name="OneClickButton" Grid.Column="2" Content="一键扫描"
                                Style="{StaticResource AccentButton}" Click="OneClickButton_Click"
                                VerticalAlignment="Center" Padding="46,14" FontSize="16" Cursor="Hand"/>
                    </Grid>
                </Border>

                <!-- 一键清理范围 -->
                <Border Background="{StaticResource SectionFillBrush}" CornerRadius="12" Padding="18,14" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="一键清理范围" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SelectedSummaryText" Grid.Column="1" Text="已选择 11 / 11 项"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="SelectAllButton" Content="全选" Style="{StaticResource FluentButton}"
                                        Padding="16,2" MinHeight="28" FontSize="12" Margin="0,0,8,0"
                                        Click="SelectAllButton_Click" Cursor="Hand"/>
                                <Button x:Name="ClearSelectionButton" Content="清空" Style="{StaticResource FluentButton}"
                                        Padding="16,2" MinHeight="28" FontSize="12" Margin="0,0,8,0"
                                        Click="ClearSelectionButton_Click" Cursor="Hand"/>
                                <ToggleButton x:Name="CustomizeToggle" Content="展开 ▾"
                                              Style="{StaticResource FluentToggleButton}"
                                              Click="CustomizeToggle_Click"/>
                            </StackPanel>
                        </Grid>
                        <Border x:Name="CustomizePanel" Visibility="Collapsed" Margin="0,12,0,0"
                                Background="{StaticResource ControlFillBrush}" CornerRadius="8" Padding="14,12,14,6">
                            <WrapPanel x:Name="CategoryCheckPanel" Orientation="Horizontal"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 分类卡片 -->
                <UniformGrid Columns="3">
            <Border Background="{StaticResource SectionFillBrush}" CornerRadius="12" Padding="18" Margin="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Image Source="/icon/browser.png" Width="42" Height="42" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Grid.Row="1" Text="浏览器缓存" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,10,0,0"/>
                    <TextBlock Grid.Row="2" Text="清理Chrome、Edge等浏览器缓存数据" FontSize="12" Margin="0,4,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34"/>
                    <Button Grid.Row="3" Content="清理" Style="{StaticResource FluentButton}"
                            Click="CleanBrowserCache_Click" HorizontalAlignment="Right" Margin="0,12,0,0"
                            Padding="22,4" MinHeight="28" FontSize="12" Cursor="Hand"/>
                </Grid>
            </Border>
            <Border Background="{StaticResource SectionFillBrush}" CornerRadius="12" Padding="18" Margin="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Image Source="/icon/qq.png" Width="42" Height="42" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Grid.Row="1" Text="QQ缓存" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,10,0,0"/>
                    <TextBlock Grid.Row="2" Text="清理QQ缓存和临时文件（不删除图片、视频、语音、文件）" FontSize="12" Margin="0,4,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34"/>
                    <Button Grid.Row="3" Content="清理" Style="{StaticResource FluentButton}"
                            Click="CleanQQCache_Click" HorizontalAlignment="Right" Margin="0,12,0,0"
                            Padding="22,4" MinHeight="28" FontSize="12" Cursor="Hand"/>
                </Grid>
            </Border>
            <Border Background="{StaticResource SectionFillBrush}" CornerRadius="12" Padding="18" Margin="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Image Source="/icon/wechat.png" Width="42" Height="42" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Grid.Row="1" Text="微信缓存" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,10,0,0"/>
                    <TextBlock Grid.Row="2" Text="清理微信缓存和日志文件" FontSize="12" Margin="0,4,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34"/>
                    <Button Grid.Row="3" Content="清理" Style="{StaticResource FluentButton}"
                            Click="CleanWeChatCache_Click" HorizontalAlignment="Right" Margin="0,12,0,0"
                            Padding="22,4" MinHeight="28" FontSize="12" Cursor="Hand"/>
                </Grid>
            </Border>
            <Border Background="{StaticResource SectionFillBrush}" CornerRadius="12" Padding="18" Margin="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Image Source="/icon/qqmusic.png" Width="42" Height="42" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Grid.Row="1" Text="QQ音乐缓存" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,10,0,0"/>
                    <TextBlock Grid.Row="2" Text="清理QQ音乐播放缓存" FontSize="12" Margin="0,4,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34"/>
                    <Button Grid.Row="3" Content="清理" Style="{StaticResource FluentButton}"
                            Click="CleanQQMusicCache_Click" HorizontalAlignment="Right" Margin="0,12,0,0"
                            Padding="22,4" MinHeight="28" FontSize="12" Cursor="Hand"/>
                </Grid>
            </Border>
            <Border Background="{StaticResource SectionFillBrush}" CornerRadius="12" Padding="18" Margin="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Image Source="/icon/cloudmusic.png" Width="42" Height="42" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Grid.Row="1" Text="网易云音乐缓存" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,10,0,0"/>
                    <TextBlock Grid.Row="2" Text="清理网易云音乐播放缓存" FontSize="12" Margin="0,4,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34"/>
                    <Button Grid.Row="3" Content="清理" Style="{StaticResource FluentButton}"
                            Click="CleanCloudMusicCache_Click" HorizontalAlignment="Right" Margin="0,12,0,0"
                            Padding="22,4" MinHeight="28" FontSize="12" Cursor="Hand"/>
                </Grid>
            </Border>
            <Border Background="{StaticResource SectionFillBrush}" CornerRadius="12" Padding="18" Margin="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Image Source="/icon/kugou.png" Width="42" Height="42" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Grid.Row="1" Text="酷狗音乐缓存" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,10,0,0"/>
                    <TextBlock Grid.Row="2" Text="清理酷狗音乐播放缓存" FontSize="12" Margin="0,4,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34"/>
                    <Button Grid.Row="3" Content="清理" Style="{StaticResource FluentButton}"
                            Click="CleanKuGouCache_Click" HorizontalAlignment="Right" Margin="0,12,0,0"
                            Padding="22,4" MinHeight="28" FontSize="12" Cursor="Hand"/>
                </Grid>
            </Border>
            <Border Background="{StaticResource SectionFillBrush}" CornerRadius="12" Padding="18" Margin="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Image Source="/icon/douyin.png" Width="42" Height="42" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Grid.Row="1" Text="抖音缓存" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,10,0,0"/>
                    <TextBlock Grid.Row="2" Text="清理抖音视频缓存" FontSize="12" Margin="0,4,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34"/>
                    <Button Grid.Row="3" Content="清理" Style="{StaticResource FluentButton}"
                            Click="CleanDouyinCache_Click" HorizontalAlignment="Right" Margin="0,12,0,0"
                            Padding="22,4" MinHeight="28" FontSize="12" Cursor="Hand"/>
                </Grid>
            </Border>
            <Border Background="{StaticResource SectionFillBrush}" CornerRadius="12" Padding="18" Margin="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Width="42" Height="42" CornerRadius="10" Background="#22d3ee" HorizontalAlignment="Left">
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#FFFFFF" Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4M12,6A6,6 0 0,1 18,12A6,6 0 0,1 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6M12,8A4,4 0 0,0 8,12A4,4 0 0,0 12,16A4,4 0 0,0 16,12A4,4 0 0,0 12,8Z"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <TextBlock Grid.Row="1" Text="高级清理" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,10,0,0"/>
                    <TextBlock Grid.Row="2" Text="自定义选择清理项目" FontSize="12" Margin="0,4,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34"/>
                    <Button Grid.Row="3" Content="选择" Style="{StaticResource FluentButton}"
                            Click="AdvancedClean_Click" HorizontalAlignment="Right" Margin="0,12,0,0"
                            Padding="22,4" MinHeight="28" FontSize="12" Cursor="Hand"/>
                </Grid>
            </Border>
            <Border Background="{StaticResource SectionFillBrush}" CornerRadius="12" Padding="18" Margin="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Width="42" Height="42" CornerRadius="10" Background="#8b5cf6" HorizontalAlignment="Left">
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#FFFFFF" Data="M19,3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3M10,17L5,12L6.41,10.59L10,14.17L17.59,6.58L19,8L10,17Z"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <TextBlock Grid.Row="1" Text="此电脑快捷方式" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,10,0,0"/>
                    <TextBlock Grid.Row="2" Text="清理此电脑中软件创建的快捷方式" FontSize="12" Margin="0,4,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34"/>
                    <Button Grid.Row="3" Content="选择" Style="{StaticResource FluentButton}"
                            Click="CleanMyComputerShortcuts_Click" HorizontalAlignment="Right" Margin="0,12,0,0"
                            Padding="22,4" MinHeight="28" FontSize="12" Cursor="Hand"/>
                </Grid>
            </Border>
            <Border Background="{StaticResource SectionFillBrush}" CornerRadius="12" Padding="18" Margin="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Width="42" Height="42" CornerRadius="10" Background="#fbbf24" HorizontalAlignment="Left">
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#FFFFFF" Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,6A6,6 0 0,0 6,12A6,6 0 0,0 12,18A6,6 0 0,0 18,12A6,6 0 0,0 12,6M12,8A4,4 0 0,1 16,12A4,4 0 0,1 12,16A4,4 0 0,1 8,12A4,4 0 0,1 12,8Z"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <TextBlock Grid.Row="1" Text="系统缓存" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,10,0,0"/>
                    <TextBlock Grid.Row="2" Text="清理Windows临时文件和系统缓存" FontSize="12" Margin="0,4,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34"/>
                    <Button Grid.Row="3" Content="清理" Style="{StaticResource FluentButton}"
                            Click="CleanSystemCache_Click" HorizontalAlignment="Right" Margin="0,12,0,0"
                            Padding="22,4" MinHeight="28" FontSize="12" Cursor="Hand"/>
                </Grid>
            </Border>
            <Border Background="{StaticResource SectionFillBrush}" CornerRadius="12" Padding="18" Margin="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Width="42" Height="42" CornerRadius="10" Background="#4ade80" HorizontalAlignment="Left">
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#FFFFFF" Data="M19 3H5C3.9 3 3 3.9 3 5V19C3 20.1 3.9 21 5 21H19C20.1 21 21 20.1 21 19V5C21 3.9 20.1 3 19 3M9 17H7V10H9V17M13 17H11V7H13V17M17 17H15V13H17V17Z"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <TextBlock Grid.Row="1" Text="系统日志" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,10,0,0"/>
                    <TextBlock Grid.Row="2" Text="清除Windows系统日志" FontSize="12" Margin="0,4,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34"/>
                    <Button Grid.Row="3" Content="清理" Style="{StaticResource FluentButton}"
                            Click="CleanSystemLogs_Click" HorizontalAlignment="Right" Margin="0,12,0,0"
                            Padding="22,4" MinHeight="28" FontSize="12" Cursor="Hand"/>
                </Grid>
            </Border>
            <Border Background="{StaticResource SectionFillBrush}" CornerRadius="12" Padding="18" Margin="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Width="42" Height="42" CornerRadius="10" Background="#60a5fa" HorizontalAlignment="Left">
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#FFFFFF" Data="M3,12V6.75L9,5.43V11.91L3,12M20,3V11.75L10,11.9V5.21L20,3M3,13L9,13.09V19.9L3,18.75V13M20,13.25V22L10,20.09V13.1L20,13.25Z"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <TextBlock Grid.Row="1" Text="微软应用商店缓存" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,10,0,0"/>
                    <TextBlock Grid.Row="2" Text="清理微软应用商店缓存，解决应用下载或更新问题" FontSize="12" Margin="0,4,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34"/>
                    <Button Grid.Row="3" Content="清理" Style="{StaticResource FluentButton}"
                            Click="CleanStoreCache_Click" HorizontalAlignment="Right" Margin="0,12,0,0"
                            Padding="22,4" MinHeight="28" FontSize="12" Cursor="Hand"/>
                </Grid>
            </Border>
            <Border Background="{StaticResource SectionFillBrush}" CornerRadius="12" Padding="18" Margin="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Width="42" Height="42" CornerRadius="10" Background="#f472b6" HorizontalAlignment="Left">
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#FFFFFF" Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4M12,6A6,6 0 0,1 18,12A6,6 0 0,1 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6M12,8A4,4 0 0,0 8,12A4,4 0 0,0 12,16A4,4 0 0,0 16,12A4,4 0 0,0 12,8Z"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <TextBlock Grid.Row="1" Text="桌面图标缓存" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,10,0,0"/>
                    <TextBlock Grid.Row="2" Text="清理桌面图标缓存并重启资源管理器，修复图标显示问题" FontSize="12" Margin="0,4,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34"/>
                    <Button Grid.Row="3" Content="清理" Style="{StaticResource FluentButton}"
                            Click="CleanIconCache_Click" HorizontalAlignment="Right" Margin="0,12,0,0"
                            Padding="22,4" MinHeight="28" FontSize="12" Cursor="Hand"/>
                </Grid>
            </Border>
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
