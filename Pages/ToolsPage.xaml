<Page x:Class="SystemTool.Pages.ToolsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="其他工具"
      Background="Transparent"
      TextOptions.TextFormattingMode="Ideal"
      TextOptions.TextRenderingMode="ClearType"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True">

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Hidden">
            <StackPanel Margin="30,15,30,20">

                <!-- 页头 -->
                <Border Background="{StaticResource SectionFillBrush}" CornerRadius="12"
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                        Padding="22,18" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="其他工具" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="共 2 个实用工具 · 系统精简与软件卸载" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <UniformGrid Columns="2" Margin="-6,0,-6,8">

                    <Border Background="{StaticResource SectionFillBrush}" CornerRadius="12"
                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                            Padding="18" Margin="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Win11Debloat" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Grid.Row="1" Text="Windows 11 精简工具，移除预装应用、禁用遥测和优化系统设置" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,14" TextWrapping="Wrap" MinHeight="34"/>
                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <Button Content="运行 Win11Debloat" Style="{StaticResource AccentButton}" Click="RunWin11Debloat_Click" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Background="{StaticResource SectionFillBrush}" CornerRadius="12"
                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                            Padding="18" Margin="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="软件卸载" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Grid.Row="1" Text="使用 Geek 卸载工具彻底卸载软件" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,14" TextWrapping="Wrap" MinHeight="34"/>
                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <Button Content="打开卸载工具" Style="{StaticResource AccentButton}" Click="OpenGeekUninstaller_Click" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Background="{StaticResource SectionFillBrush}" CornerRadius="12"
                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                            Padding="18" Margin="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="激活 Windows" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Grid.Row="1" Text="使用 Microsoft Activation Scripts 激活 Windows 系统" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,14" TextWrapping="Wrap" MinHeight="34"/>
                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <Button Content="激活 Windows" Style="{StaticResource AccentButton}" Click="ActivateWindows_Click" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                </UniformGrid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
