<Page x:Class="SystemTool.Pages.LogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:Services="clr-namespace:SystemTool.Services"
      Title="应用日志"
      Background="Transparent"
      TextOptions.TextFormattingMode="Ideal"
      TextOptions.TextRenderingMode="ClearType"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True">

    <Page.Resources>
        <DropShadowEffect x:Key="CardShadow" Color="#000000" Opacity="0.3" BlurRadius="15" ShadowDepth="3" Direction="270"/>
    </Page.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#12121f" CornerRadius="16" Margin="30,15,30,10">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.3" BlurRadius="15" ShadowDepth="3" Direction="270"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="20,15">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="8" Background="#1e1e35">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="#60a5fa" Data="M19 3H5C3.9 3 3 3.9 3 5V19C3 20.1 3.9 21 5 21H19C20.1 21 21 20.1 21 19V5C21 3.9 20.1 3 19 3M12 18C11.45 18 11 17.55 11 17S11.45 16 12 16 13 16.45 13 17 12.55 18 12 18M13 13H11V7H13V13Z"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <TextBlock Text="应用日志" FontSize="16" FontWeight="Normal" Foreground="#ffffff" 
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="导出" Cursor="Hand" Click="ExportLogs_Click" Margin="0,0,8,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ExportButtonBorder" Background="#4ade80" CornerRadius="6" Width="60" Height="28">
                                            <TextBlock Text="{TemplateBinding Content}" FontSize="11" 
                                                       Foreground="#ffffff" FontWeight="Normal"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ExportButtonBorder" Property="Background" Value="#22c55e"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Content="清空" Cursor="Hand" Click="ClearLogs_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ButtonBorder" Background="#e94560" CornerRadius="6" Width="60" Height="28">
                                            <TextBlock Text="{TemplateBinding Content}" FontSize="11" 
                                                       Foreground="#ffffff" FontWeight="Normal"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ButtonBorder" Property="Background" Value="#ff6b8a"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <ListBox Grid.Row="1" ItemsSource="{Binding Logs, Source={x:Static Services:LogService.Instance}}"
                         Background="Transparent" BorderThickness="0" Padding="10,0,10,10"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1a1a2e" CornerRadius="6" Padding="10,6" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Timestamp}" 
                                               Foreground="#7a7a9a" FontSize="10" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" CornerRadius="3" Padding="5,1" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#3b82f6"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="Success">
                                                        <Setter Property="Background" Value="#22c55e"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                        <Setter Property="Background" Value="#f59e0b"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="Error">
                                                        <Setter Property="Background" Value="#ef4444"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="9" Foreground="#ffffff" FontWeight="Normal">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="信息"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Level}" Value="Success">
                                                            <Setter Property="Text" Value="成功"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                            <Setter Property="Text" Value="警告"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="Error">
                                                            <Setter Property="Text" Value="错误"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding Message}" 
                                               Foreground="#e0e0f0" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#12121f" CornerRadius="16" Margin="30,10,30,20">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.3" BlurRadius="15" ShadowDepth="3" Direction="270"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="20,15">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="8" Background="#1e1e35">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="#a78bfa" Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4M12,6A6,6 0 0,1 18,12A6,6 0 0,1 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6M12,8A4,4 0 0,0 8,12A4,4 0 0,0 12,16A4,4 0 0,0 16,12A4,4 0 0,0 12,8Z"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <TextBlock Text="更新日志" FontSize="16" FontWeight="Normal" Foreground="#ffffff" 
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ListBox Grid.Row="1" ItemsSource="{Binding UpdateLogs, Source={x:Static Services:LogService.Instance}}"
                         Background="Transparent" BorderThickness="0" Padding="10,0,10,10"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1a1a2e" CornerRadius="6" Padding="12,10" Margin="0,0,0,6">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#8b5cf6" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Version}" FontSize="11" Foreground="#ffffff" FontWeight="Normal"/>
                                            </Border>
                                            <TextBlock Text="{Binding Date}" FontSize="10" Foreground="#7a7a9a" 
                                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding Content}" FontSize="11" Foreground="#c0c0d0" 
                                               TextWrapping="Wrap" LineHeight="18"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</Page>
