<Page x:Class="SystemTool.Pages.LogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:Services="clr-namespace:SystemTool.Services"
      Title="应用日志"
      Background="Transparent"
      TextOptions.TextFormattingMode="Ideal"
      TextOptions.TextRenderingMode="ClearType"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True">

    <Grid Margin="30,15,30,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <!-- 顶部：标题 + 统计 + 筛选 + 操作 -->
        <Border Grid.Row="0" Background="{StaticResource SectionFillBrush}" CornerRadius="12"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Padding="20,14" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource AccentSoftBrush}">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{StaticResource AccentBrush}" Data="M19 3H5C3.9 3 3 3.9 3 5V19C3 20.1 3.9 21 5 21H19C20.1 21 21 20.1 21 19V5C21 3.9 20.1 3 19 3M12 18C11.45 18 11 17.55 11 17S11.45 16 12 16 13 16.45 13 17 12.55 18 12 18M13 13H11V7H13V13Z"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="应用日志" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                    <Run Text="共 "/><Run x:Name="TotalCountText" Text="0"/><Run Text=" 条"/>
                                </TextBlock>
                                <TextBlock FontSize="11" Foreground="#3b82f6" Margin="12,0,0,0">
                                    <Run Text="信息 "/><Run x:Name="InfoCountText" Text="0"/>
                                </TextBlock>
                                <TextBlock FontSize="11" Foreground="#22c55e" Margin="12,0,0,0">
                                    <Run Text="成功 "/><Run x:Name="SuccessCountText" Text="0"/>
                                </TextBlock>
                                <TextBlock FontSize="11" Foreground="#f59e0b" Margin="12,0,0,0">
                                    <Run Text="警告 "/><Run x:Name="WarningCountText" Text="0"/>
                                </TextBlock>
                                <TextBlock FontSize="11" Foreground="#ef4444" Margin="12,0,0,0">
                                    <Run Text="错误 "/><Run x:Name="ErrorCountText" Text="0"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="导出" Style="{StaticResource FluentButton}" Width="72" Click="ExportLogs_Click" Margin="0,0,8,0"/>
                        <Button Content="清空" Style="{StaticResource FluentButton}" Width="72" Click="ClearLogs_Click"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock Text="级别筛选" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ToggleButton x:Name="FilterAllBtn" Content="全部" Tag="All" IsChecked="True"
                                  Style="{StaticResource FluentToggleButton}" Margin="0,0,6,0"
                                  Checked="FilterButton_Checked" Unchecked="FilterButton_Unchecked"/>
                    <ToggleButton x:Name="FilterInfoBtn" Content="信息" Tag="Info"
                                  Style="{StaticResource FluentToggleButton}" Margin="0,0,6,0"
                                  Checked="FilterButton_Checked" Unchecked="FilterButton_Unchecked"/>
                    <ToggleButton x:Name="FilterSuccessBtn" Content="成功" Tag="Success"
                                  Style="{StaticResource FluentToggleButton}" Margin="0,0,6,0"
                                  Checked="FilterButton_Checked" Unchecked="FilterButton_Unchecked"/>
                    <ToggleButton x:Name="FilterWarningBtn" Content="警告" Tag="Warning"
                                  Style="{StaticResource FluentToggleButton}" Margin="0,0,6,0"
                                  Checked="FilterButton_Checked" Unchecked="FilterButton_Unchecked"/>
                    <ToggleButton x:Name="FilterErrorBtn" Content="错误" Tag="Error"
                                  Style="{StaticResource FluentToggleButton}"
                                  Checked="FilterButton_Checked" Unchecked="FilterButton_Unchecked"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 日志列表 -->
        <Border Grid.Row="1" Background="{StaticResource SectionFillBrush}" CornerRadius="12"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Margin="0,0,0,12">
            <Grid>
                <ListBox x:Name="LogListBox"
                         Background="Transparent" BorderThickness="0" Padding="12,10"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource ControlFillBrush}" CornerRadius="6" Padding="10,7" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Timestamp}"
                                               Foreground="{StaticResource TextTertiaryBrush}" FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" CornerRadius="4" Padding="7,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#3b82f6"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="Success">
                                                        <Setter Property="Background" Value="#22c55e"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                        <Setter Property="Background" Value="#f59e0b"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="Error">
                                                        <Setter Property="Background" Value="#ef4444"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="10" Foreground="#ffffff">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="信息"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Level}" Value="Success">
                                                            <Setter Property="Text" Value="成功"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                            <Setter Property="Text" Value="警告"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="Error">
                                                            <Setter Property="Text" Value="错误"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding Message}"
                                               Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
                <TextBlock x:Name="EmptyHintText" Text="暂无此级别的日志" FontSize="13"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- 更新日志 -->
        <Border Grid.Row="2" Background="{StaticResource SectionFillBrush}" CornerRadius="12"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,14,20,10">
                    <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource AccentSoftBrush}">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#a78bfa" Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4M12,6A6,6 0 0,1 18,12A6,6 0 0,1 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6M12,8A4,4 0 0,0 8,12A4,4 0 0,0 12,16A4,4 0 0,0 16,12A4,4 0 0,0 12,8Z"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <TextBlock Text="更新日志" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <ListBox Grid.Row="1" ItemsSource="{Binding UpdateLogs, Source={x:Static Services:LogService.Instance}}"
                         Background="Transparent" BorderThickness="0" Padding="12,0,12,10"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource ControlFillBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,6">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Background="#8b5cf6" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Version}" FontSize="11" Foreground="#ffffff"/>
                                        </Border>
                                        <TextBlock Text="{Binding Date}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}"
                                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Content}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" LineHeight="20"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</Page>
